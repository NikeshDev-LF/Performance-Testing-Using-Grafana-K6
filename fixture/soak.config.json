{
  "testName": "Soak Test",
  "testType": "soak_test",
  "stages": [
    { "duration": "5m", "target": 30 },
    { "duration": "4h", "target": 30 },
    { "duration": "5m", "target": 0 }
  ],
  "thresholds": {
    "http_req_duration": ["p(95)<600", "p(99)<1200"],
    "http_req_failed": ["rate<0.05"],
    "errors": ["rate<0.05"],
    "api_response_time": ["p(95)<500"],
    "group_duration{group:::visit product listing page}": ["p(95)<600"],
    "group_duration{group:::add products to cart}": ["p(95)<500"],
    "group_duration{group:::view cart}": ["p(95)<400"],
    "group_duration{group:::checkout process}": ["p(95)<1200"]
  },
  "thresholdLimits": {
    "productsResponseTime": 600,
    "addToCartResponseTime": 500,
    "viewCartResponseTime": 400,
    "checkoutResponseTime": 1200
  },
  "sleepTimes": {
    "afterAddToCart": "random",
    "afterIteration": "random"
  },
  "reportPath": "reports/soak/soak-test-report.html",
  "jsonReportPath": "reports/soak/soak-test-report.json"
}
